# Copy to .env.local and adjust as needed.

# Backend API base URL. Leave empty for same-origin requests — that is what the
# released image wants, since Spring Boot serves the SPA and the API from one port.
# Only set this when the API lives on a different origin than the SPA; `yarn dev`
# already gets http://localhost:8080 from the committed .env.development.
# Note: .env.local is read by production builds too, so a value set here also ends
# up baked into any bundle built on this machine.
VITE_BACKEND_BASE_URL=

# Set to "true" to use mock data instead of hitting the backend API.
VITE_USE_MOCK_DATA=false
