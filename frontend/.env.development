# Loaded by `yarn dev` only (Vite reads .env.development in dev mode, never in a
# production build). The dev server runs on :5173 while the backend runs on :8081,
# so the SPA needs an absolute cross-origin base URL here. Production builds leave
# VITE_BACKEND_BASE_URL unset and talk to their own origin — see src/config/env.ts.
VITE_BACKEND_BASE_URL=http://localhost:8081
